# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=
# 본인 디스코드 유저 ID (개발자 모드 켜고 프로필 우클릭 > ID 복사)
OWNER_ID=
# 데이터 저장 위치
DATA_DIR=./data
# ChatGPT 모델/추론 강도 (/ai model 로도 변경 가능)
AI_MODEL=gpt-6.1-sol
AI_EFFORT=low
# 서버 감시 알림 임계값 (넘으면 DM, 회복되면 다시 DM)
ALERT_MEM_PCT=90
ALERT_DISK_PCT=90
ALERT_LOAD_PER_CPU=2.0
# 다른 사람도 답변의 "이어서 질문" 버튼으로 질문 가능 (1=허용, 0=나만)
AI_GUEST_BUTTONS=1
# 다른 사람 1명당 횟수/초 (기본 10분에 5번)
AI_GUEST_LIMIT=5/600
# 기억은 대화 중 GPT가 직접 관리. 1로 켜면 대화 후 뒤에서 한 번 더 정리 (사용량 추가)
AI_MEMORY_AUTO=0
AI_MEMORY_IDLE=90
# 서버 명령 실행: off / local(봇 프로세스 권한) / host(도커에서 호스트로, compose.shell.yaml 필요)
AI_SHELL=off
AI_SHELL_TIMEOUT=60
